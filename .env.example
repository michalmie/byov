NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (required) ---
# Postgres connection string for ALL Control Plane data (API tokens,
# apps, auth bootstrap, mail account, OTP codes, rate limits, workspace
# state). The server fails fast at first use when this is unset or not a
# postgres:// URL. See docs/database.md.
DATABASE_URL=postgres://byov:byov@localhost:5432/byov
DEPLOY_DRY_RUN=1

# --- Nodes: Coolify deploy adapter ---
# Bearer token the Control Plane uses to provision and deploy apps on
# Coolify nodes (create app, set FQDN, deploy, status, logs). One shared
# token is the operator fallback when a node has no token saved in Settings -> Nodes (the normal path); one shared
# token covers every Coolify node without a saved token; COOLIFY_TOKEN_<NODE_SLUG> (slug
# uppercased, hyphens as underscores, e.g. COOLIFY_TOKEN_COOLIFY_FRANKFURT)
# overrides it per node. Tokens stay server-side only.
COOLIFY_API_TOKEN=
# Shared secret for push webhooks (x-byov-webhook-secret header) as an
# alternative to a machine token. Blank disables secret auth.
BYOV_WEBHOOK_SECRET=

# --- Auth: sessions, access list, passwordless ---
# Secret for signing session cookies and magic-link tokens. Required in
# production; when unset the server falls back to an insecure dev secret.
AUTH_SECRET=
# Who may sign in: exact emails and/or domains (comma-separated). When both
# are empty any email may sign in (dev default, with a warning).
AUTH_ALLOWED_EMAILS=
AUTH_ALLOWED_DOMAINS=
# Workspace admins by email (comma-separated). When empty AND no bootstrap
# claim exists yet, the first user to sign in becomes admin automatically
# and the claim is recorded in Postgres (fresh-install bootstrap).
AUTH_ADMIN_EMAILS=
# Pin the Secure flag on auth cookies (true/false). When empty it follows
# the request scheme: Secure on HTTPS, off on plain HTTP (previews, LAN).
AUTH_COOKIE_SECURE=
# Sign-in methods. Passwordless code + magic link default to on; OAuth
# providers default to off until explicitly enabled AND configured below.
AUTH_PASSWORDLESS_ENABLED=true
AUTH_MAGIC_LINK_ENABLED=true
AUTH_ENTRA_ENABLED=false
AUTH_GITHUB_ENABLED=false
AUTH_GOOGLE_ENABLED=false
AUTH_APPLE_ENABLED=false

# --- Auth: outbound mail for codes and links ---
# Server default sending account. A Settings-saved account (Settings →
# Email, admin-only) overrides these; when neither exists, mail is logged
# to the server console (dev fallback) instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Auth: OAuth provider credentials ---
# Enable a provider above, register BYOV at the provider with redirect URI
# {NEXT_PUBLIC_SITE_URL}/api/auth/oauth/<entra|github|google|apple>/callback,
# then fill in its credentials here.
# Microsoft Entra ID (tenant: GUID, domain, or common/organizations/consumers)
AZURE_AD_CLIENT_ID=
AZURE_AD_TENANT_ID=common
AZURE_AD_CLIENT_SECRET=
# GitHub OAuth app
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OIDC client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple Services ID + Sign in with Apple key (PEM with literal \n escapes)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# SIEM webhook: every audit event is also POSTed here as JSON
# ({source:"byov", id, actor, text, appSlug, createdAt}). Blank disables.
BYOV_SIEM_WEBHOOK_URL=
