NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_PROFILE=mysql
DATABASE_URL=
DEPLOY_DRY_RUN=1

# --- Auth: sessions, access list, passwordless ---
# Secret for signing session cookies and magic-link tokens. Required in
# production; when unset the server falls back to an insecure dev secret.
AUTH_SECRET=
# Who may sign in: exact emails and/or domains (comma-separated). When both
# are empty any email may sign in (dev default, with a warning).
AUTH_ALLOWED_EMAILS=
AUTH_ALLOWED_DOMAINS=
# Workspace admins by email (comma-separated). When empty AND no bootstrap
# claim exists yet, the first user to sign in becomes admin automatically
# and the claim is recorded under AUTH_DATA_DIR (fresh-install bootstrap).
AUTH_ADMIN_EMAILS=
# Server data dir for the bootstrap admin record. Defaults to ./data.
AUTH_DATA_DIR=
# Server data dir for the control-plane API (tokens, apps). Defaults to
# AUTH_DATA_DIR when set, else ./data. Files are created owner-only.
BYOV_DATA_DIR=
# Pin the Secure flag on auth cookies (true/false). When empty it follows
# the request scheme: Secure on HTTPS, off on plain HTTP (previews, LAN).
AUTH_COOKIE_SECURE=
# Sign-in methods. Passwordless code + magic link default to on; OAuth
# providers default to off until explicitly enabled AND configured below.
AUTH_PASSWORDLESS_ENABLED=true
AUTH_MAGIC_LINK_ENABLED=true
AUTH_ENTRA_ENABLED=false
AUTH_GITHUB_ENABLED=false
AUTH_GOOGLE_ENABLED=false
AUTH_APPLE_ENABLED=false

# --- Auth: outbound mail for codes and links ---
# Server default sending account. A Settings-saved account (Settings →
# Email, admin-only) overrides these; when neither exists, mail is logged
# to the server console (dev fallback) instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Auth: OAuth provider credentials ---
# Enable a provider above, register BYOV at the provider with redirect URI
# {NEXT_PUBLIC_SITE_URL}/api/auth/oauth/<entra|github|google|apple>/callback,
# then fill in its credentials here.
# Microsoft Entra ID (tenant: GUID, domain, or common/organizations/consumers)
AZURE_AD_CLIENT_ID=
AZURE_AD_TENANT_ID=common
AZURE_AD_CLIENT_SECRET=
# GitHub OAuth app
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OIDC client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple Services ID + Sign in with Apple key (PEM with literal \n escapes)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
